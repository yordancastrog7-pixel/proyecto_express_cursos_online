{
  "name": "proyecto-semana-06",
  "version": "1.0.0",
  "description": "Proyecto: API con MongoDB y Mongoose",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "seed": "tsx --env-file=.env src/seed.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "mongoose": "9.4.1",
    "morgan": "1.12.0",
    "winston": "3.19.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/morgan": "1.9.10",
    "@types/node": "22.15.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
