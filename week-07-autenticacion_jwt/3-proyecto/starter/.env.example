PORT=3007
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27019/cursos_online_auth

# Dos secretos DISTINTOS, largos y aleatorios (mínimo 32 caracteres).
# Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Estos valores de ejemplo NO sirven: la app se niega a arrancar con ellos.
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-para-access
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-distinto-largo-y-aleatorio-para-refresh
