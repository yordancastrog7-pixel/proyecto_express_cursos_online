{
  "name": "proyecto-semana-07",
  "version": "1.0.0",
  "description": "Proyecto: API con autenticación JWT (bcrypt, access/refresh tokens, cookies HttpOnly)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "9.4.1",
    "morgan": "1.12.0",
    "winston": "3.19.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "22.15.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
