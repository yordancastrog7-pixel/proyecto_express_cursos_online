PORT=3008
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27020/cursos_online_rbac

# Orígenes (páginas web) que pueden llamar a la API desde un navegador, separados por coma.
# Nunca "*": la app se niega a arrancar si lo pones.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Dos secretos DISTINTOS, largos y aleatorios (mínimo 32 caracteres).
# Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Estos valores de ejemplo NO sirven: la app se niega a arrancar con ellos.
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-para-access
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-distinto-largo-y-aleatorio-para-refresh

# Primer administrador (lo crea `pnpm seed:admin`). Pon una contraseña real de 8+
# caracteres con letras y números; el valor de ejemplo no sirve.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@cursos.com
ADMIN_PASSWORD=cambia-esto-por-una-contrasena-real-123
